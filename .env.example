# EduTrack Environment Configuration Template
SECRET_KEY=replace-with-a-secure-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Defaults to SQLite for local development)
# To use PostgreSQL in production, set DB_ENGINE=postgresql and fill connection details:
DB_ENGINE=sqlite
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Optional AI API Key (Gemini API for progress insights)
GEMINI_API_KEY=
